# HTTPS automat (Let's Encrypt) pentru beestyle.ro. www → fără www.
www.beestyle.ro {
	redir https://beestyle.ro{uri} permanent
}

beestyle.ro {
	encode zstd gzip
	reverse_proxy wp:80 {
		header_up X-Forwarded-Proto https
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

# Site static al unui partener (fișiere urcate prin SFTP în /srv/partner/site, montate doar-citire).
# Nu are legătură cu WordPress; o eroare aici nu afectează beestyle.ro.
www.fairclickagency.com {
	redir https://fairclickagency.com{uri} permanent
}

fairclickagency.com {
	encode zstd gzip
	root * /srv/fairclick
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
