# Copiază ca docker/secrets.env și completează. Fișierul real NU se comite (e în .gitignore).
# Valorile reale le ai de la proprietar (transfer separat, nu prin git/chat public).

# Secretul endpoint-urilor de sync/crawl (orice șir lung aleatoriu; crawlerele
# și worker-ul primesc același șir în variabila SECRET).
HAINUTE_SYNC_SECRET=

# CJ: ID-ul proprietății (PID) + ID-urile de link deeplink per advertiser,
# necesare ca linkurile Answear/Sportisimo să fie afiliate.
HAINUTE_CJ_WEBSITE_ID=
HAINUTE_CJ_AIDS={"answear":"","sportisimo":""}

# Opțional (din 22.10.2026 wp-admin e fără cheie): /?admin=CHEIA doar redirecționează la wp-admin
HAINUTE_ADMIN_KEY=

# --- Server (docker-compose.prod.yml) ---
# Adresa finală a site-ului
HAINUTE_SITE_URL=https://beestyle.ro
# Pre-lansare: 1 = site încuiat (401 + noindex peste tot), acces cu /?acces=CHEIA_PRELANSARE
# La lansare: 0, apoi `docker compose -f docker-compose.prod.yml up -d`
HAINUTE_PRELAUNCH=1
HAINUTE_PRELAUNCH_KEY=

# --- Opțional: importul din feed-urile rețelelor (fără ele site-ul și crawlerele merg,
# doar nu se importă produse NOI din feed-uri) ---
# CJ GraphQL (token personal + company id)
HAINUTE_CJ_TOKEN=
HAINUTE_CJ_COMPANY_ID=
# 2Performant (various-brands)
HAINUTE_2P_EMAIL=
HAINUTE_2P_PASSWORD=
# Profitshare (Fashion Days, advertiser 88736)
HAINUTE_PS_USER=
HAINUTE_PS_KEY=
